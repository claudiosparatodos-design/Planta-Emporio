# Copia este archivo a .env (o define las variables en tu servidor). Todas son opcionales.

# Puerto HTTP del servidor
PORT=3000
# Carpeta donde se guardan la base de datos, los archivos subidos y los respaldos
DATA_DIR=./data
# URL pública (se usa en enlaces de invitación y recuperación). Ej. https://planta.tudominio.com
PUBLIC_URL=

# Límites de archivos
MAX_FILE_MB=25
STORAGE_QUOTA_MB=5120
BACKUPS_TO_KEEP=14

# Respaldo continuo en Turso (gratis). OBLIGATORIO en alojamientos sin disco permanente (Render gratis).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Correo gratis por la API de Brevo (funciona aunque el alojamiento bloquee SMTP, como Render gratis)
BREVO_API_KEY=
MAIL_FROM=

# Correo (opcional). Si no se configura, las invitaciones y recuperaciones se comparten con enlace.
# Requiere una cuenta SMTP propia (p. ej. el correo de tu dominio). Puede tener costo según el proveedor.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# SOLO para probar en local sin HTTPS con NODE_ENV=production. Nunca en un servidor público.
# INSECURE_COOKIES=1
